{
  "name": "@haldir/pipeline",
  "version": "0.1.1",
  "description": "Haldir pipeline — orchestrates 5-layer vetting pipeline for agent skills",
  "license": "Apache-2.0",
  "author": "Haldir AI <oss@haldir.ai>",
  "homepage": "https://haldir.ai",
  "repository": {
    "type": "git",
    "url": "https://github.com/haldir-ai/haldir.git",
    "directory": "packages/pipeline"
  },
  "keywords": [
    "haldir",
    "pipeline",
    "agent",
    "security",
    "vetting",
    "skills"
  ],
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.23.4 <23 || >=24.22.1 <25 || >=26.12.1"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@haldir/scanner": "workspace:*",
    "@haldir/auditor": "workspace:*",
    "@haldir/sandbox": "workspace:*",
    "@haldir/reviewer": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
