{
  "name": "@haldir/cli",
  "version": "0.1.1",
  "description": "Haldir CLI — keygen, sign, verify, inspect, cosign, revoke, scan, audit, sandbox, review, enforce",
  "license": "Apache-2.0",
  "author": "Haldir AI <oss@haldir.ai>",
  "homepage": "https://haldir.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/haldir-ai/haldir.git",
    "directory": "packages/cli"
  },
  "keywords": [
    "haldir",
    "cli",
    "agent",
    "security",
    "signing",
    "verification",
    "skills"
  ],
  "type": "module",
  "bin": {
    "haldir": "dist/index.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.23.4 <23 || >=24.22.1 <25 || >=26.12.1"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@haldir/core": "workspace:*",
    "@haldir/auditor": "workspace:*",
    "@haldir/reviewer": "workspace:*",
    "@haldir/sandbox": "workspace:*",
    "@haldir/scanner": "workspace:*",
    "@haldir/enforcer": "workspace:*",
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
