{
  "name": "@haldir/registry",
  "version": "0.1.1",
  "description": "Haldir registry API — skill submission, vetting, publisher tiers, federation",
  "license": "Apache-2.0",
  "author": "Haldir AI <oss@haldir.ai>",
  "homepage": "https://haldir.ai",
  "repository": {
    "type": "git",
    "url": "https://github.com/haldir-ai/haldir.git",
    "directory": "packages/registry"
  },
  "keywords": [
    "haldir",
    "registry",
    "agent",
    "security",
    "skills",
    "api"
  ],
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.23.4 <23 || >=24.22.1 <25 || >=26.12.1"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@haldir/pipeline": "workspace:*",
    "@haldir/scanner": "workspace:*",
    "@haldir/core": "workspace:*",
    "express": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
